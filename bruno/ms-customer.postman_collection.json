    {
      "name": "1b. Autenticacion (login)",
      "item": [
        {
          "name": "Login con credenciales correctas (200)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.test(\"Devuelve accessToken Bearer\", function () {",
                  "    const body = pm.response.json();",
                  "    pm.expect(body.accessToken).to.be.a(\"string\").and.not.be.empty;",
                  "    pm.expect(body.tokenType).to.eql(\"Bearer\");",
                  "    pm.expect(body.expiresIn).to.eql(3600);",
                  "});",
                  "pm.collectionVariables.set(\"accessToken\", pm.response.json().accessToken);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"documentType\": \"DNI\",\n  \"documentNumber\": \"{{dni}}\",\n  \"password\": \"ClaveSegura1\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
